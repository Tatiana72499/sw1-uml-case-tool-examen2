# Create n8n/.env.sandbox from this template and replace every placeholder with
# a unique random secret. Do not commit the real .env.sandbox file.
N8N_SANDBOX_SERVICE_API_KEY=replace-with-random-api-key
SANDBOX_API_KEYS=replace-with-the-same-random-api-key
SANDBOX_API_RUNNER_REGISTRATION_TOKEN=replace-with-random-registration-token
SANDBOX_API_RUNNER_API_KEY=replace-with-random-runner-key
SANDBOX_RUNNER_REGISTRATION_TOKEN=replace-with-the-same-random-registration-token
SANDBOX_RUNNER_API_KEYS=replace-with-the-same-random-runner-key
